# Server
PORT=3001
NODE_ENV=production

# Auth
JWT_SECRET=replace_with_a_long_random_string
CORS_ORIGIN=https://amertak-tools.vercel.app,https://www.amertak-tools.vercel.app

# MongoDB
MONGOURL=mongodb+srv://username:password@cluster.mongodb.net/?appName=toolsAmertak

# Optional tool settings
OPENAI_API_KEY=sk-your-api-key-here
YTDLP_PATH=yt-dlp

# Base URL (for generating share links)
BASE_URL=https://amertak.tools

# Storage Provider: local | cloudinary | s3 | b2
STORAGE_PROVIDER=local

# Local storage directory (only for STORAGE_PROVIDER=local)
LOCAL_UPLOAD_DIR=./uploads

# Max upload size in MB
MAX_UPLOAD_SIZE_MB=100

# Cloudinary (only for STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# S3 / Backblaze B2 (only for STORAGE_PROVIDER=s3 or b2)
S3_REGION=us-east-1
S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
S3_BUCKET=amertak-share
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
